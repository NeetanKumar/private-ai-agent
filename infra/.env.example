# Copy to infra/.env (never commit the real file).
GATEWAY_PORT=8080
# Address the published port binds to. Keep 127.0.0.1, or use this host's Tailscale IP. Never 0.0.0.0.
GATEWAY_BIND=127.0.0.1
# Bearer token for the "owner" user. `make init` fills this in with a random value.
GATEWAY_TOKEN_OWNER=
# Frontier lane key. Leave empty to keep the frontier lane disabled.
ANTHROPIC_API_KEY=
# gpu profile: leave unset (gateway uses the ollama container).
# mac-dev profile: point at Ollama running natively on the host.
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Only needed if you list gmail_* / calendar_* under actions.enabled in infra/config.yaml.
# Get these by running: python scripts/google_oauth_setup.py (needs a one-time browser login).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
