# Copy to infra/.env (never commit the real file).
GATEWAY_PORT=8080
# Bearer token for the "owner" user. Generate with: openssl rand -hex 32
GATEWAY_TOKEN_OWNER=
# Frontier lane key. Leave empty to keep the frontier lane disabled.
ANTHROPIC_API_KEY=
# gpu profile: leave unset (gateway uses the ollama container).
# mac-dev profile: point at Ollama running natively on the host.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
